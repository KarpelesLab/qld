# Maintainer: (fill in for an AUR submission)
#
# Follows https://wiki.archlinux.org/title/Rust_package_guidelines.
# For a build from the git tree, use pkgname=qld-git, source=("git+$url.git")
# and a pkgver() from `git describe`.

pkgname=qld
pkgver=0.1.0
pkgrel=1
pkgdesc='A fast, parallel linker compatible with GNU ld, gold, lld and mold'
arch=('x86_64' 'aarch64')
url='https://github.com/KarpelesLab/qld'
license=('MIT')
depends=('gcc-libs' 'glibc')
makedepends=('cargo')
checkdepends=('gcc' 'binutils')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
# Replace with the tarball's checksum once the tag exists (`updpkgsums`).
# The release's SHA256SUMS lists the binary archives, not this tarball.
sha256sums=('SKIP')

prepare() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo test --frozen
}

package() {
  cd "$pkgname-$pkgver"
  # bin/qld, bin/ld.qld, bin/ld64.qld and /usr/lib/qld/ld (Arch keeps
  # libexec files under /usr/lib): clang -fuse-ld=qld finds ld.qld, and
  # gcc -B/usr/lib/qld runs /usr/lib/qld/ld.
  sh packaging/install.sh --prefix /usr --libexecdir /usr/lib \
    --destdir "$pkgdir" target/release/qld
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
